<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512" role="img" aria-label="CardVault">
  <defs>
    <linearGradient id="bg" x1="15%" y1="10%" x2="85%" y2="90%">
      <stop offset="0%" stop-color="#1a1e2c"/>
      <stop offset="70%" stop-color="#0b0d14"/>
    </linearGradient>
    <radialGradient id="glowY" cx="25%" cy="15%" r="55%">
      <stop offset="0%" stop-color="#ffcb05" stop-opacity="0.35"/>
      <stop offset="100%" stop-color="#ffcb05" stop-opacity="0"/>
    </radialGradient>
    <radialGradient id="glowR" cx="80%" cy="88%" r="55%">
      <stop offset="0%" stop-color="#e0302d" stop-opacity="0.35"/>
      <stop offset="100%" stop-color="#e0302d" stop-opacity="0"/>
    </radialGradient>
    <linearGradient id="brand" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ffd23d"/>
      <stop offset="55%" stop-color="#ff9a3d"/>
      <stop offset="100%" stop-color="#e0302d"/>

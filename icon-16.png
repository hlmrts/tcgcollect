  </defs>

  <rect width="512" height="512" rx="116" fill="url(#bg)"/>
  <rect width="512" height="512" rx="116" fill="url(#glowY)"/>
  <rect width="512" height="512" rx="116" fill="url(#glowR)"/>
  <rect width="512" height="512" rx="116" fill="none" stroke="#2a2f40" stroke-width="2"/>

  <g>
    <rect x="176" y="130" width="130" height="182" rx="16" transform="rotate(-16 241 221)" fill="#2a2f40" stroke="#3a4054" stroke-width="4"/>
    <rect x="206" y="130" width="130" height="182" rx="16" transform="rotate(10 271 221)" fill="#353b52" stroke="#454c68" stroke-width="4"/>
    <rect x="191" y="160" width="130" height="182" rx="16" fill="url(#brand)"/>
    <path d="M256 210 l10 24 26 4-19 18 5 26-22-13-22 13 5-26-19-18 26-4z" fill="#ffffff" opacity="0.9"/>
  </g>
